{
  "description": "config-sync (JakobMelchard/bin) copies each source to its destination inside the consumer repo. Consumers reference the .config/ copies; root dotfiles are picked up by their tools directly.",
  "files": {
    "eslint/base.js":            ".config/eslint.base.js",
    "prettier/prettierrc.json":  ".config/prettier.json",
    "tsconfig/base.json":        ".config/tsconfig.base.json",
    "ruff/ruff.toml":            ".config/ruff.toml",
    "gitleaks/gitleaks.toml":    ".gitleaks.toml",
    "editorconfig/editorconfig": ".editorconfig"
  },
  "examples": {
    "release-please/config.json":   "release-please-config.json",
    "release-please/manifest.json": ".release-please-manifest.json",
    "renovate/default.json":        "renovate.json"
  }
}
